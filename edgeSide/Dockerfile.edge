FROM python:3.12-slim
RUN pip install --no-cache-dir paho-mqtt

RUN pip install --upgrade setuptools pip wheel

RUN pip install openpyxl
RUN pip install pandas numexpr
RUN pip install packaging


RUN pip install tables --no-deps
RUN pip install --upgrade psutil
RUN pip install setuptools

WORKDIR /app
COPY MQTTTest/mqttEdge.py .
COPY mainEdge/utility/ /app/utility/
COPY mainEdge/preProcessingDataTEP.py .

CMD [ "python", "mqttEdge.py"]

